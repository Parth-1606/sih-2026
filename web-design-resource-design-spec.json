  "project_change_protocol": {
    "instruction": "For future website changes, prefer a small structured change request rather than asking the coding agent to reinterpret the entire design.",
    "example": {
      "change_request": {
        "target": "hero",
        "priority": "high",
        "changes": [
          {
            "property": "heading_size",
            "action": "increase",
            "value": "7rem"
          },
          {
            "property": "hero_spacing",
            "action": "increase",
            "value": "128px"
          },
          {
            "property": "animation",
            "action": "reduce",
            "reason": "Current motion feels excessive"
          }
        ],
        "preserve": [
          "Typography family",
          "Color system",
          "Responsive layout",
          "Existing component structure"
        ]
      }
    }
  },
  "agent_output_contract": {
    "preferred_format_for_configuration": "JSON",
    "preferred_format_for_human_reasoning": "Markdown",
    "preferred_format_for_implementation": "Project source code",
    "preferred_format_for_visual_verification": "Browser/screenshot review",
    "rule": "Use JSON for machine-readable design tokens, resource selection, component specifications, and change requests; use prose/Markdown for nuanced visual reasoning."
  },
