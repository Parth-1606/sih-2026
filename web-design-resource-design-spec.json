{
  "name": "web-design-resource-design-spec",
  "version": "1.0.0",
  "purpose": "Persistent design-resource catalog for AI-assisted website projects. Add this file to each project so the coding agent can consult the approved visual, UI, animation, icon, background, logo, inspiration, and AI-skill resources before implementing or modifying the site.",
  "usage_rules": {
    "primary_goal": "Reduce generic AI-generated website slop by giving the coding agent a curated resource vocabulary and explicit usage guidance.",
    "agent_behavior": [
      "Consult this catalog before choosing UI components, icons, fonts, animations, backgrounds, or visual effects.",
      "Prefer resources already listed here over introducing unrelated libraries.",
      "Do not add a new dependency solely because it can produce a visually flashy effect.",
      "Use the smallest appropriate resource for the job.",
      "Preserve the existing project's visual language when making changes.",
      "Do not blindly combine multiple animation or visual-effect libraries when one is sufficient.",
      "Avoid unnecessary decorative effects, excessive gradients, excessive motion, and generic SaaS/AI visual patterns unless the project specification explicitly requests them.",
      "Before adding a dependency, check whether an existing listed resource already solves the requirement.",
      "Treat links marked as unverified as references that require human confirmation before dependency installation."
    ],
    "implementation_priority": [
      "Existing project design system and components",
      "Resources explicitly selected by the project",
      "Resources in this catalog",
      "New external resources only when necessary and explicitly justified"
    ]
  },
  "design_principles": {
    "aesthetic": [
      "Minimal",
      "Intentional",
      "Strong typography",
      "High-quality spacing",
      "Controlled visual density",
      "Purposeful motion",
      "Avoid visual clutter"
    ],
    "anti_slop_rules": [
      "Do not add sections just to make a page longer.",
      "Do not use effects merely because they are available.",
      "Do not animate every element.",
      "Do not mix incompatible visual styles without a reason.",
      "Do not introduce arbitrary component libraries when an existing project component can be reused.",
      "Do not replace working implementations unnecessarily."
    ]
  },
